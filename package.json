{
  "name": "folia-tauri",
  "productName": "Folia",
  "description": "Lyrics Reimagine (Tauri 二开)",
  "author": {
    "name": "chthollyphile",
    "email": "chthollyphile@users.noreply.github.com"
  },
  "private": true,
  "version": "0.6.12",
  "license": "AGPL-3.0",
  "type": "module",
  "main": "src-tauri/tauri.conf.json",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:tauri": "cross-env ELECTRON=true vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c vitest.config.ts",
    "test:unit": "vitest run -c vitest.config.ts",
    "test:unit:watch": "vitest -c vitest.config.ts",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri:app": "tauri build",
    "build:tauri:dir": "tauri build --no-bundle",
    "build:tauri:rust": "cargo build --manifest-path src-tauri/Cargo.toml --release --features tauri/custom-protocol",
    "build:tauri:smoke": "npm run build:tauri && cargo build --manifest-path src-tauri/Cargo.toml --features tauri/custom-protocol",
    "build:tauri:app:size": "cross-env CARGO_PROFILE_RELEASE_LTO=thin CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 CARGO_PROFILE_RELEASE_INCREMENTAL=false tauri build",
    "update:manifest": "node scripts/generate-update-manifest.mjs"
  },
  "dependencies": {
    "@applemusic-like-lyrics/ttml": "^1.0.1",
    "@chenglou/pretext": "^0.0.8",
    "@google/genai": "^2.12.0",
    "@paper-design/shaders-react": "^0.0.77",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tauri-apps/api": "^2.10.0",
    "@xmldom/xmldom": "^0.9.10",
    "blueimp-md5": "^2.19.0",
    "buffer": "^6.0.3",
    "dexie": "^4.4.4",
    "fflate": "^0.8.3",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.25.0",
    "music-metadata": "^11.14.0",
    "opencc-js": "^1.4.1",
    "pixi.js": "^8.19.0",
    "react": "^19.2.7",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "react-window": "^2.2.7",
    "three": "^0.185.1",
    "twgl.js": "^7.0.0",
    "wanakana": "^5.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.10.0",
    "@types/blueimp-md5": "^2.18.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "^2.10.43",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "@discordjs/rest": {
      "undici": "^6.27.0"
    }
  }
